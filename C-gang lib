    local TabBar = Create("ScrollingFrame", {
        Size = UDim2.new(0, 95, 1, -48),
        Position = UDim2.fromOffset(5, 44),
        BackgroundColor3 = Theme.Secondary,
        BorderSizePixel = 0,
