        TextColor3 = GREEN,
        TextSize = 11,
        Font = Enum.Font.GothamBold,
        TextXAlignment = Enum.TextXAlignment.Left
    }, frame)

    local input = Create("TextBox", {
        Position = UDim2.fromOffset(8, 20),
        Size = UDim2.fromOffset(120, 23),
        BackgroundColor3 = BG,
        TextColor3 = GREEN,
        PlaceholderColor3 = LIGHT_GREEN,
        PlaceholderText = options.Placeholder or "Digite aqui...",
        Text = "",
        TextSize = 12,
        Font = Enum.Font.Gotham,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextWrapped = true,
        ClearTextOnFocus = false,
        MultiLine = true
    }, frame)

    Corner(input, 4)
    Stroke(input, GREEN, 1)

    input:GetPropertyChangedSignal("Text"):Connect(function()
        local count = #input.Text

        local width = math.min(
            120 + math.floor(count / 5) * 12,
            250
        )

        local lines = math.max(1, math.ceil(count / 32))
        local height = 23 + math.max(0, lines - 1) * 15

        input.Size = UDim2.fromOffset(width, height)

        frame.Size = UDim2.new(
            1,
            -8,
            0,
            48 + height - 23
        )
    end)

    input.FocusLost:Connect(function()
        Protect(options.Callback, input.Text)
    end)

    return input
end

