        function Tab:AddColorpicker(data)
            data = data or {}

            local color = data.Default or Color3.fromRGB(0, 255, 145)
            local Frame = Element(42)

            local Label = Create("TextLabel", {
                Size = UDim2.new(1, -65, 1, 0),
                Position = UDim2.fromOffset(10, 0),
                BackgroundTransparency = 1,
                Text = data.Name or "Color Picker",
                TextColor3 = Theme.Text,
                Font = Enum.Font.Gotham,
                TextSize = 12,
                TextXAlignment = Enum.TextXAlignment.Left
            }, Frame)

            local Preview = Create("TextButton", {
                Size = UDim2.fromOffset(35, 25),
                Position = UDim2.new(1, -45, 0.5, -12),
                BackgroundColor3 = color,
                Text = "",
                BorderSizePixel = 0
            }, Frame)

            Corner(Preview, 6)

            local Picker = Element(0)
            Picker.Size = UDim2.new(1, -8, 0, 0)
            Picker.ClipsDescendants = true

            local open = false

            Preview.Activated:Connect(function()
                open = not open
                Picker.Size = open and UDim2.new(1, -8, 0, 105) or UDim2.new(1, -8, 0, 0)
            end)

            local hue = Create("TextButton", {
                Size = UDim2.new(1, -20, 0, 16),
                Position = UDim2.fromOffset(10, 10),
                BackgroundColor3 = Color3.new(1, 1, 1),
                Text = "",
                BorderSizePixel = 0
            }, Picker)

            Create("UIGradient", {
                Color = ColorSequence.new({
                    ColorSequenceKeypoint.new(0, Color3.new(1,0,0)),
                    ColorSequenceKeypoint.new(0.2, Color3.new(1,1,0)),
                    ColorSequenceKeypoint.new(0.4, Color3.new(0,1,0)),
                    ColorSequenceKeypoint.new(0.6, Color3.new(0,1,1)),
                    ColorSequenceKeypoint.new(0.8, Color3.new(0,0,1)),
                    ColorSequenceKeypoint.new(1, Color3.new(1,0,0))
                })
            }, hue)

            local function ChangeColor(x)
                local percent = math.clamp(
                    (x - hue.AbsolutePosition.X) / hue.AbsoluteSize.X,
                    0, 1
                )

                color = Color3.fromHSV(percent, 1, 1)
                Preview.BackgroundColor3 = color

                if data.Callback then
                    data.Callback(color)
                end
            end

            hue.Activated:Connect(function()
                ChangeColor(UIS:GetMouseLocation().X)
            end)

            return {
                Set = function(_, newColor)
                    color = newColor
                    Preview.BackgroundColor3 = color
                    if data.Callback then
                        data.Callback(color)
                    end
                end
            }
        end

