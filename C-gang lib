local function RestoreWindow()
    Restore.Visible = false
    Main.Visible = true
    Main.BackgroundTransparency = 0
    Main.Size = UDim2.fromOffset(0, 0)

    Tween(Main, {
        Size = UDim2.fromOffset(420, 260)
