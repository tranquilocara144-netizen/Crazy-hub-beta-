        ScrollBarImageColor3 = Theme.Green,
        CanvasSize = UDim2.new(0, 0, 0, 0)
    }, Main)

    local ContentLayout = Create("UIListLayout", {
        Padding = UDim.new(0, 7),
        SortOrder = Enum.SortOrder.LayoutOrder
    }, Content)

    local function UpdateCanvas(frame, layout)
        frame.CanvasSize = UDim2.new(
            0, 0, 0, layout.AbsoluteContentSize.Y + 12
        )
    end

    TabLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        UpdateCanvas(TabBar, TabLayout)
    end)

    ContentLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        UpdateCanvas(Content, ContentLayout)
    end)

    -- FLOATING BUTTON

    local Floating = Create("ImageButton", {
        Name = "CGangFloating",
        Size = UDim2.fromOffset(55, 55),
        Position = UDim2.new(0, 20, 0.5, -27),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Image = "rbxassetid://117283747154295",
        Visible = false,
        AutoButtonColor = false
    }, Screen)

    local floatDragging = false
    local moved = false
    local floatStart
    local floatPosition

    Floating.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then

            floatDragging = true
            moved = false
            floatStart = input.Position
            floatPosition = Floating.Position

            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    floatDragging = false
                end
            end)
        end
    end)

    UIS.InputChanged:Connect(function(input)
        if floatDragging then
            if input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch then

                local delta = input.Position - floatStart

                if delta.Magnitude > 5 then
                    moved = true
                end

                Floating.Position = UDim2.new(
                    floatPosition.X.Scale,
                    floatPosition.X.Offset + delta.X,
                    floatPosition.Y.Scale,
                    floatPosition.Y.Offset + delta.Y
                )
            end
        end
    end)

    local minimized = false

    local function Restore()
        minimized = false
        Main.Visible = true
        Floating.Visible = false
    end

    Floating.Activated:Connect(function()
        if not moved then
            Restore()
        end
    end)

    Minimize.Activated:Connect(function()
        minimized = true
        Main.Visible = false
        Floating.Visible = true
    end)

    Close.Activated:Connect(function()
        Screen:Destroy()
    end)

