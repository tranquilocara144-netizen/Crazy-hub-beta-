local function AddToggle(tab, options)
    options = options or {}

    local state = options.Default == true

    local frame = NewComponent(tab, 38)
    frame.BackgroundColor3 = BLACK

    Corner(frame, 6)
    Stroke(frame, GREEN, 1)

    NewText(frame, options.Name or "TOGGLE", 13, true)

    local switch = Create("TextButton", {
        Position = UDim2.new(1, -55, 0, 8),
        Size = UDim2.fromOffset(43, 22),
        BackgroundColor3 = Color3.fromRGB(12, 20, 14),
        Text = "",
        AutoButtonColor = false
    }, frame)

    Corner(switch, 5)
    Stroke(switch, GREEN, 1)

    local handle = Create("Frame", {
        Position = UDim2.fromOffset(state and 23 or 2, -2),
        Size = UDim2.fromOffset(18, 24),
        BackgroundColor3 = state and LIGHT_GREEN or DARK_GREEN,
        BorderSizePixel = 0
    }, switch)

    Corner(handle, 4)

    local function SetState(newState)
        state = newState

        Tween(handle, {
            Position = UDim2.fromOffset(state and 23 or 2, -2),
            BackgroundColor3 = state and LIGHT_GREEN or DARK_GREEN
        }, 0.18)

        Protect(options.Callback, state)
    end

    switch.MouseButton1Click:Connect(function()
        SetState(not state)
    end)

    return {
        Set = SetState,
        Get = function()
            return state
        end
    }
end

