-- GIF POR SEQUÊNCIA DE IMAGENS

local function AddGif(tab, options)
    options = options or {}

    local frames = options.Frames or {}
    local height = options.Size and options.Size.Y.Offset or 150

    local frame = NewComponent(tab, height)
    frame.BackgroundTransparency = 1

    local image = Create("ImageLabel", {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        ScaleType = Enum.ScaleType.Fit
    }, frame)

    local running = true
    local speed = options.Speed or 0.12

    task.spawn(function()
        local index = 1

        while running and image.Parent and #frames > 0 do
            image.Image = frames[index]
            index = index + 1

            if index > #frames then
                index = 1
            end

            task.wait(speed)
        end
    end)

    frame.Destroying:Connect(function()
        running = false
    end)

    return image
end

