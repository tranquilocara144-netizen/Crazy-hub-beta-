local C-Gang = {}

local Players = game:GetService("Players")
local UIS = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local CoreGui = game:GetService("CoreGui")

local Player = Players.LocalPlayer

local Parent = CoreGui
pcall(function()
    if not gethui then
        error("No gethui")
    end
    Parent = gethui()
end)

local Theme = {
    Background = Color3.fromRGB(13, 15, 17),
    Secondary = Color3.fromRGB(22, 25, 27),
    Element = Color3.fromRGB(29, 33, 35),
    Text = Color3.fromRGB(240, 240, 240),
    Muted = Color3.fromRGB(145, 150, 150),
    Green = Color3.fromRGB(0, 255, 145),
    Blue = Color3.fromRGB(0, 180, 255)
}

local function Create(class, props, parent)
    local obj = Instance.new(class)

    for k, v in pairs(props or {}) do
        obj[k] = v
    end

    obj.Parent = parent
    return obj
end

local function Corner(parent, radius)
    return Create("UICorner", {
        CornerRadius = UDim.new(0, radius or 8)
    }, parent)
end

local function Stroke(parent, color, transparency)
    return Create("UIStroke", {
        Color = color or Theme.Green,
        Transparency = transparency or 0,
        Thickness = 1
    }, parent)
end

local function Gradient(parent)
    return Create("UIGradient", {
        Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, Theme.Green),
            ColorSequenceKeypoint.new(1, Theme.Blue)
        }),
        Rotation = 35
    }, parent)
end

local function Tween(obj, properties, duration)
    TweenService:Create(
        obj,
        TweenInfo.new(duration or 0.2),
        properties
    ):Play()
end

local function Drag(object, handle)
    local dragging = false
    local start
    local position
    local activeInput

    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then

            dragging = true
            start = input.Position
            position = object.Position
            activeInput = input

            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)

    UIS.InputChanged:Connect(function(input)
        if dragging then
            if input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch then

                local delta = input.Position - start

                object.Position = UDim2.new(
                    position.X.Scale,
                    position.X.Offset + delta.X,
                    position.Y.Scale,
                    position.Y.Offset + delta.Y
                )
            end
        end
    end)
end

