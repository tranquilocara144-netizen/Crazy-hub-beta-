    -- TABS

    local Window = {}

    function Window:MakeTab(tabConfig)
        tabConfig = tabConfig or {}

        local TabName = tabConfig.Name or "TAB"

        local TabButton = Create("TextButton", {
            Size = UDim2.new(1, -8, 0, 32),
            BackgroundColor3 = Theme.Element,
            BorderSizePixel = 0,
            Text = TabName,
            TextColor3 = Theme.Muted,
            Font = Enum.Font.GothamBold,
            TextSize = 11
        }, TabBar)

        Corner(TabButton, 7)

        local Page = Create("Frame", {
            Size = UDim2.new(1, 0, 0, 0),
            AutomaticSize = Enum.AutomaticSize.Y,
            BackgroundTransparency = 1,
            Visible = false
        }, Content)

        local Layout = Create("UIListLayout", {
            Padding = UDim.new(0, 7),
            SortOrder = Enum.SortOrder.LayoutOrder
        }, Page)

        local function SelectTab()
            for _, child in pairs(Content:GetChildren()) do
                if child:IsA("Frame") and child ~= Page then
                    child.Visible = false
                end
            end

            Page.Visible = true

            TabButton.BackgroundColor3 = Theme.Green
            TabButton.TextColor3 = Color3.new(0, 0, 0)

            for _, button in pairs(TabBar:GetChildren()) do
                if button:IsA("TextButton") and button ~= TabButton then
                    button.BackgroundColor3 = Theme.Element
                    button.TextColor3 = Theme.Muted
                end
            end
        end

        TabButton.Activated:Connect(SelectTab)

        if #Content:GetChildren() == 2 then
            SelectTab()
        end

        local Tab = {}

        local function Element(height)
            local Frame = Create("Frame", {
                Size = UDim2.new(1, -8, 0, height),
                BackgroundColor3 = Theme.Element,
                BorderSizePixel = 0
            }, Page)

            Corner(Frame, 8)
            return Frame
        end

        -- BUTTON

        function Tab:AddButton(data)
            data = data or {}

            local Frame = Element(38)

            local Button = Create("TextButton", {
                Size = UDim2.new(1, 0, 1, 0),
                BackgroundTransparency = 1,
                Text = data.Name or "Button",
                TextColor3 = Theme.Text,
                Font = Enum.Font.GothamBold,
                TextSize = 12
            }, Frame)

            Button.Activated:Connect(function()
                Tween(Frame, {
                    BackgroundColor3 = Theme.Green
                }, 0.1)

                task.delay(0.15, function()
                    if Frame.Parent then
                        Tween(Frame, {
                            BackgroundColor3 = Theme.Element
                        }, 0.1)
                    end
                end)

                if data.Callback then
                    task.spawn(data.Callback)
                end
            end)

            return Frame
        end

        -- TOGGLE

        function Tab:AddToggle(data)
            data = data or {}

            local value = data.Default or false
            local Frame = Element(42)

            Create("TextLabel", {
                Size = UDim2.new(0.7, 0, 1, 0),
                Position = UDim2.fromOffset(10, 0),
                BackgroundTransparency = 1,
                Text = data.Name or "Toggle",
                TextColor3 = Theme.Text,
                Font = Enum.Font.Gotham,
                TextSize = 12,
                TextXAlignment = Enum.TextXAlignment.Left
            }, Frame)

            local Switch = Create("TextButton", {
                Size = UDim2.fromOffset(42, 22),
                Position = UDim2.new(1, -52, 0.5, -11),
                BackgroundColor3 = value and Theme.Green or Theme.Background,
                Text = "",
                BorderSizePixel = 0
            }, Frame)

            Corner(Switch, 15)

            local Circle = Create("Frame", {
                Size = UDim2.fromOffset(16, 16),
                Position = value and UDim2.new(1, -19, 0, 3) or UDim2.fromOffset(3, 3),
                BackgroundColor3 = Color3.new(1, 1, 1),
                BorderSizePixel = 0
            }, Switch)

            Corner(Circle, 20)

            Switch.Activated:Connect(function()
                value = not value

                Tween(Switch, {
                    BackgroundColor3 = value and Theme.Green or Theme.Background
                })

                Tween(Circle, {
                    Position = value and UDim2.new(1, -19, 0, 3)
                    or UDim2.fromOffset(3, 3)
                })

                if data.Callback then
                    task.spawn(data.Callback, value)
                end
            end)

            return {
                Set = function(_, v)
                    value = v
                    Switch.BackgroundColor3 = value and Theme.Green or Theme.Background
                    Circle.Position = value and UDim2.new(1, -19, 0, 3) or UDim2.fromOffset(3, 3)
                    if data.Callback then
                        data.Callback(value)
                    end
                end
            }
        end

        -- SLIDER

        function Tab:AddSlider(data)
            data = data or {}

            local min = data.Min or 0
            local max = data.Max or 100
            local value = math.clamp(data.Default or min, min, max)
            local increment = data.Increment or 1

            local Frame = Element(58)

            local Label = Create("TextLabel", {
                Size = UDim2.new(1, -20, 0, 22),
                Position = UDim2.fromOffset(10, 2),
                BackgroundTransparency = 1,
                Text = (data.Name or "Slider") .. ": " .. value,
                TextColor3 = Theme.Text,
                Font = Enum.Font.Gotham,
                TextSize = 12,
                TextXAlignment = Enum.TextXAlignment.Left
            }, Frame)

            local Bar = Create("TextButton", {
                Size = UDim2.new(1, -20, 0, 7),
                Position = UDim2.fromOffset(10, 39),
                BackgroundColor3 = Theme.Background,
                Text = "",
                BorderSizePixel = 0
            }, Frame)

            Corner(Bar, 10)

            local Fill = Create("Frame", {
                Size = UDim2.new((value-min)/(max-min), 0, 1, 0),
                BackgroundColor3 = Theme.Green,
                BorderSizePixel = 0
            }, Bar)

            Corner(Fill, 10)

            local function SetValue(x)
                local percent = math.clamp(
                    (x - Bar.AbsolutePosition.X) / Bar.AbsoluteSize.X,
                    0, 1
                )

                value = math.floor((min + (max-min)*percent) / increment + 0.5) * increment
                value = math.clamp(value, min, max)

                Fill.Size = UDim2.new((value-min)/(max-min), 0, 1, 0)
                Label.Text = (data.Name or "Slider") .. ": " .. value

                if data.Callback then
                    data.Callback(value)
                end
            end

            Bar.Activated:Connect(function()
                SetValue(UIS:GetMouseLocation().X)
            end)

            return Frame
        end

