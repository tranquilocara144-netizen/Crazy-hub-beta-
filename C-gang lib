            }
        end

        function Tab:AddSlider(data)
            data = data or {}
            local min = tonumber(data.Min) or 0
            local max = tonumber(data.Max) or 100
            if max <= min then max = min + 1 end
            local increment = tonumber(data.Increment) or 1
            if increment <= 0 then increment = 1 end
            local value = math.clamp(tonumber(data.Default) or min, min, max)

            local frame = makeElement(Page, 62)
            local nameLabel = create("TextLabel", {
                Size = UDim2.new(1, -20, 0, 20),
                Position = UDim2.fromOffset(10, 2),
                BackgroundTransparency = 1,
                Text = tostring(data.Name or "Slider"),
                TextColor3 = Theme.Text,
                Font = Enum.Font.Gotham,
                TextSize = 12,
                TextXAlignment = Enum.TextXAlignment.Left
            }, frame)

            -- Barra um pouco mais alta para o contador ficar visivel dentro dela.
            local bar = create("TextButton", {
                Size = UDim2.new(1, -20, 0, 20),
                Position = UDim2.fromOffset(10, 34),
                BackgroundColor3 = Theme.Background,
                Text = "",
                BorderSizePixel = 0,
                AutoButtonColor = false,
                ClipsDescendants = true
            }, frame)
            corner(bar, 10)

            local fill = create("Frame", {
                Size = UDim2.new((value - min) / (max - min), 0, 1, 0),
                BackgroundColor3 = Theme.Green,
                BorderSizePixel = 0,
                ZIndex = 2
            }, bar)
            corner(fill, 10)

            -- O contador e um TextLabel com largura calculada pelo proprio texto:
            -- nao existe uma hitbox invisivel larga sobrando em volta dos digitos.
            local counter = create("TextLabel", {
                Name = "SliderValue",
                AnchorPoint = Vector2.new(0.5, 0.5),
                Position = UDim2.new(0.5, 0, 0.5, 0),
                Size = UDim2.fromOffset(1, 16),
                AutomaticSize = Enum.AutomaticSize.X,
                BackgroundTransparency = 1,
                Text = tostring(value),
                TextColor3 = Color3.fromRGB(255, 255, 255),
                TextStrokeColor3 = Color3.fromRGB(0, 0, 0),
                TextStrokeTransparency = 0.45,
                Font = Enum.Font.GothamBold,
                TextSize = 11,
                TextXAlignment = Enum.TextXAlignment.Center,
                TextYAlignment = Enum.TextYAlignment.Center,
                TextWrapped = false,
                ZIndex = 3,
                Active = false,
                Selectable = false
            }, bar)

            local function refreshCounter()
                counter.Text = tostring(value)
                -- TextBounds e usado para manter a area justa ao numero exibido.
                task.defer(function()
                    if counter.Parent then
                        local width = math.max(counter.TextBounds.X + 2, 5)
                        counter.Size = UDim2.fromOffset(width, 16)
                    end
                end)
            end

            local function updateVisual()
                local percent = math.clamp((value - min) / (max - min), 0, 1)
                fill.Size = UDim2.new(percent, 0, 1, 0)
                refreshCounter()
            end

            local function setFromX(x)
                local percent = math.clamp((x - bar.AbsolutePosition.X) / math.max(bar.AbsoluteSize.X, 1), 0, 1)
                local raw = min + (max - min) * percent
                value = math.clamp(min + math.floor(((raw - min) / increment) + 0.5) * increment, min, max)
                updateVisual()
                if type(data.Callback) == "function" then
                    task.spawn(data.Callback, value)
                end
            end

            updateVisual()

            local sliding = false
            bar.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                    sliding = true
                    setFromX(input.Position.X)
                end
            end)
            UserInputService.InputChanged:Connect(function(input)
                if sliding and (input.UserInputType == Enum.UserInputType.MouseMovement
                or input.UserInputType == Enum.UserInputType.Touch) then
                    setFromX(input.Position.X)
                end
            end)
            UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                    sliding = false
                end
            end)

            return {
                Set = function(_, newValue)
                    value = math.clamp(tonumber(newValue) or min, min, max)
                    updateVisual()
                    if type(data.Callback) == "function" then data.Callback(value) end
                end,
                Get = function() return value end
            }
        end

