        -- Seletor RGB: tres campos numericos e atualizacao em tempo real.
        function Tab:AddColorpicker(data)
            data = data or {}
            local color = data.Default or Color3.fromRGB(0, 255, 145)
            local frame = makeElement(Page, 44)

            create("TextLabel", {
                Size = UDim2.new(1, -145, 1, 0),
                Position = UDim2.fromOffset(10, 0),
                BackgroundTransparency = 1,
                Text = tostring(data.Name or "Color Picker"),
                TextColor3 = Theme.Text,
                Font = Enum.Font.Gotham,
                TextSize = 12,
                TextXAlignment = Enum.TextXAlignment.Left
            }, frame)

            local preview = create("TextButton", {
                Size = UDim2.fromOffset(36, 26),
                Position = UDim2.new(1, -46, 0.5, -13),
                BackgroundColor3 = color,
                Text = "",
                BorderSizePixel = 0
            }, frame)
            corner(preview, 6)

            local picker = makeElement(Page, 0)
            picker.Size = UDim2.new(1, -8, 0, 0)
            picker.ClipsDescendants = true

            local expanded = false
            local rgb = {
                math.floor(color.R * 255 + 0.5),
                math.floor(color.G * 255 + 0.5),
                math.floor(color.B * 255 + 0.5)
            }

            local function applyColor()
                color = Color3.fromRGB(rgb[1], rgb[2], rgb[3])
                preview.BackgroundColor3 = color
                if type(data.Callback) == "function" then
                    task.spawn(data.Callback, color)
                end
            end

            local fields = {}
            local names = {"R", "G", "B"}
            for index = 1, 3 do
                local field = create("TextBox", {
                    Size = UDim2.new(0.29, 0, 0, 28),
                    Position = UDim2.new((index - 1) * 0.33, 10, 0, 12),
                    BackgroundColor3 = Theme.Background,
                    Text = tostring(rgb[index]),
                    PlaceholderText = names[index],
                    TextColor3 = Theme.Text,
                    Font = Enum.Font.Gotham,
                    TextSize = 12,
                    ClearTextOnFocus = false,
                    BorderSizePixel = 0
                }, picker)
                corner(field, 6)
                fields[index] = field

                field.FocusLost:Connect(function()
                    rgb[index] = math.clamp(tonumber(field.Text) or rgb[index], 0, 255)
                    field.Text = tostring(rgb[index])
                    applyColor()
                end)
            end

            preview.Activated:Connect(function()
                expanded = not expanded
                picker.Size = expanded and UDim2.new(1, -8, 0, 52) or UDim2.new(1, -8, 0, 0)
            end)

            return {
                Set = function(_, newColor)
                    if typeof(newColor) == "Color3" then
                        color = newColor
                        rgb = {
                            math.floor(color.R * 255 + 0.5),
                            math.floor(color.G * 255 + 0.5),
                            math.floor(color.B * 255 + 0.5)
                        }
                        for i = 1, 3 do fields[i].Text = tostring(rgb[i]) end
                        preview.BackgroundColor3 = color
                        if type(data.Callback) == "function" then data.Callback(color) end
                    end
                end,
                Get = function() return color end
            }
        end

        function Tab:AddImage(data)
            data = data or {}
            local height = tonumber(data.Height) or 100
            local frame = makeElement(Page, height + 12)
            create("ImageLabel", {
                Size = UDim2.new(1, -16, 1, -12),
                Position = UDim2.fromOffset(8, 6),
                BackgroundTransparency = 1,
                Image = data.Image or data.Url or "",
                ScaleType = Enum.ScaleType.Fit
            }, frame)
            return frame
        end

        function Tab:AddDiscord(data)
            data = data or {}
            local frame = makeElement(Page, 75)
            create("ImageLabel", {
                Size = UDim2.fromOffset(48, 48),
                Position = UDim2.fromOffset(8, 13),
                BackgroundTransparency = 1,
                Image = data.Icon or ""
            }, frame)
            create("TextLabel", {
                Size = UDim2.new(1, -75, 0, 22),
                Position = UDim2.fromOffset(65, 8),
                BackgroundTransparency = 1,
                Text = tostring(data.Name or "Discord"),
                TextColor3 = Theme.Green,
                Font = Enum.Font.GothamBold,
                TextSize = 12,
                TextXAlignment = Enum.TextXAlignment.Left
            }, frame)
            create("TextLabel", {
                Size = UDim2.new(1, -75, 0, 35),
                Position = UDim2.fromOffset(65, 30),
                BackgroundTransparency = 1,
                Text = tostring(data.Description or ""),
                TextColor3 = Theme.Text,
                Font = Enum.Font.Gotham,
                TextSize = 10,
                TextWrapped = true,
                TextXAlignment = Enum.TextXAlignment.Left
            }, frame)
            local join = create("TextButton", {
                Size = UDim2.fromOffset(55, 22),
                Position = UDim2.new(1, -65, 1, -28),
                BackgroundColor3 = Theme.Green,
                Text = "JOIN",
                TextColor3 = Color3.new(0, 0, 0),
                Font = Enum.Font.GothamBold,
                TextSize = 10
            }, frame)
            join.Activated:Connect(function()
                if data.Invite and type(setclipboard) == "function" then
                    pcall(setclipboard, data.Invite)
                end
            end)
            return frame
        end

        function Window:SelectTab(name)
            for _, button in ipairs(TabBar:GetChildren()) do
                if button:IsA("TextButton") and button.Text == name then
                    button:Activate()
                    break
                end
            end
        end

        function Window:Destroy()
            if Screen and Screen.Parent then Screen:Destroy() end
        end

        -- A janela ja nasce visivel; Init e mantido por compatibilidade Orion.
        return Window
    end

    function CGang:Init()
        return true
    end

    return Window
end

function CGang:Init()
    return true
end

return CGang
