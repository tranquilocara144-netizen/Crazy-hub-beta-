    function Window:SelectTab(name)
        for _, button in pairs(TabBar:GetChildren()) do
            if button:IsA("TextButton") and button.Text == name then
                button:Activate()
            end
        end
    end

    return Window
end

function C-Gang:Init()
    return true
end

return C-Gang
