local function AddColorPicker(tab, options)
    options = options or {}

    local color = options.Default or GREEN

    local rgb = {
        math.floor(color.R * 255),
        math.floor(color.G * 255),
        math.floor(color.B * 255)
    }

    local frame = NewComponent(tab, 112)
    frame.BackgroundColor3 = BLACK

    Corner(frame, 6)
    Stroke(frame, GREEN, 1)

    Create("TextLabel", {
        Position = UDim2.fromOffset(8, 3),
        Size = UDim2.new(1, -16, 0, 20),
        BackgroundTransparency = 1,
        Text = options.Name or "COLOR PICKER",
        TextColor3 = GREEN,
        TextSize = 12,
        Font = Enum.Font.GothamBold,
        TextXAlignment = Enum.TextXAlignment.Left
    }, frame)

    local preview = Create("Frame", {
        Position = UDim2.new(1, -38, 0, 5),
        Size = UDim2.fromOffset(25, 18),
        BackgroundColor3 = color
    }, frame)

    Corner(preview, 4)
    Stroke(preview, GREEN, 1)

    local names = {"R", "G", "B"}
    local boxes = {}

    local function UpdateColor()
        color = Color3.fromRGB(rgb[1], rgb[2], rgb[3])
        preview.BackgroundColor3 = color
        Protect(options.Callback, color)
    end

    for i = 1, 3 do
        local y = 28 + (i - 1) * 26

        Create("TextLabel", {
            Position = UDim2.fromOffset(9, y),
            Size = UDim2.fromOffset(15, 20),
            BackgroundTransparency = 1,
            Text = names[i],
            TextColor3 = GREEN,
            TextSize = 12,
            Font = Enum.Font.GothamBold
        }, frame)

        local box = Create("TextBox", {
            Position = UDim2.fromOffset(30, y),
            Size = UDim2.fromOffset(55, 20),
            BackgroundColor3 = BG,
            Text = tostring(rgb[i]),
            TextColor3 = GREEN,
            PlaceholderText = "0-255",
            TextSize = 11,
            Font = Enum.Font.Gotham,
            ClearTextOnFocus = false
        }, frame)

        Corner(box, 4)
        Stroke(box, GREEN, 1)

        boxes[i] = box

        box.FocusLost:Connect(function()
            local n = tonumber(box.Text)

            if n then
                rgb[i] = math.clamp(math.floor(n), 0, 255)
            end

            box.Text = tostring(rgb[i])
            UpdateColor()
        end)
    end

    return {
        Get = function()
            return color
        end,

        Set = function(newColor)
            color = newColor

            rgb = {
                math.floor(color.R * 255),
                math.floor(color.G * 255),
                math.floor(color.B * 255)
            }

            for i = 1, 3 do
                boxes[i].Text = tostring(rgb[i])
            end

            UpdateColor()
        end
    }
end

-- API DE ABAS

function Library:CreateWindow(options)
    options = options or {}

    local Window = {}

    function Window:AddTab(tabOptions)
        tabOptions = tabOptions or {}

        local button = Create("TextButton", {
            Size = UDim2.new(1, -2, 0, 29),
            BackgroundColor3 = BLACK,
            Text = "",
            AutoButtonColor = false
        }, TabScroll)

        Corner(button, 7)
        local buttonStroke = Stroke(button, GREEN, 1)

        Create("ImageLabel", {
            Position = UDim2.fromOffset(6, 5),
            Size = UDim2.fromOffset(19, 19),
            BackgroundTransparency = 1,
            Image = tabOptions.Icon or ""
        }, button)

        local tabLabel = Create("TextLabel", {
            Position = UDim2.fromOffset(30, 0),
            Size = UDim2.new(1, -34, 1, 0),
            BackgroundTransparency = 1,
            Text = tabOptions.Name or "TAB",
            TextColor3 = LIGHT_GREEN,
            TextSize = 10,
            Font = Enum.Font.GothamBold,
            TextXAlignment = Enum.TextXAlignment.Left
        }, button)

        local page = Create("ScrollingFrame", {
            Name = tabOptions.Name or "TabPage",
            Size = UDim2.new(1, 0, 1, 0),
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            ScrollBarThickness = 3,
            ScrollBarImageColor3 = GREEN,
            AutomaticCanvasSize = Enum.AutomaticSize.Y,
            CanvasSize = UDim2.new(0, 0, 0, 0),
            Visible = false
        }, Content)

        Create("UIPadding", {
            PaddingTop = UDim.new(0, 3),
            PaddingBottom = UDim.new(0, 5),
            PaddingLeft = UDim.new(0, 2),
            PaddingRight = UDim.new(0, 2)
        }, page)

        AddLayout(page)

        local tab = {
            Button = button,
            ButtonStroke = buttonStroke,
            Page = page
        }

        table.insert(Tabs, tab)

        button.MouseButton1Click:Connect(function()
            SelectTab(tab)
        end)

        function tab:AddButton(o)
            return AddButton(tab, o)
        end

        function tab:AddSlider(o)
            return AddSlider(tab, o)
        end

        function tab:AddToggle(o)
            return AddToggle(tab, o)
        end

        function tab:AddTextbox(o)
            return AddTextbox(tab, o)
        end

        function tab:AddParagraph(o)
            return AddParagraph(tab, o)
        end

        function tab:AddParagraphCenter(o)
            return AddParagraphCenter(tab, o)
        end

        function tab:AddImage(o)
            return AddImage(tab, o)
        end

        function tab:AddGif(o)
            return AddGif(tab, o)
        end

        function tab:AddDiscordServer(o)
            return AddDiscordServer(tab, o)
        end

        function tab:AddColorPicker(o)
            return AddColorPicker(tab, o)
        end

        if #Tabs == 1 then
            SelectTab(tab)
        end

        return tab
    end

    return Window
end

return Library
