-- SLIDER

local function AddSlider(tab, options)
    options = options or {}

    local min = options.Min or 0
    local max = options.Max or 100
    local increment = options.Increment or 1
    local value = math.clamp(options.Default or min, min, max)

    local frame = NewComponent(tab, 58)
    frame.BackgroundColor3 = BLACK

    Corner(frame, 6)
    Stroke(frame, GREEN, 1)

    Create("TextLabel", {
        Position = UDim2.fromOffset(8, 2),
        Size = UDim2.new(1, -16, 0, 18),
        BackgroundTransparency = 1,
        Text = options.Name or "SLIDER",
        TextColor3 = GREEN,
        TextSize = 12,
        Font = Enum.Font.GothamBold,
        TextXAlignment = Enum.TextXAlignment.Left
    }, frame)

    local bar = Create("Frame", {
        Position = UDim2.new(0, 8, 0, 25),
        Size = UDim2.new(1, -16, 0, 27),
        BackgroundColor3 = Color3.fromRGB(12, 20, 14),
        BorderSizePixel = 0
    }, frame)

    Corner(bar, 5)
    Stroke(bar, GREEN, 1)

    local fill = Create("Frame", {
        Size = UDim2.new((value - min) / (max - min), 0, 1, 0),
        BackgroundColor3 = GREEN,
        BorderSizePixel = 0
    }, bar)

    Corner(fill, 5)

    local number = Create("TextLabel", {
        Size = UDim2.new(0, 50, 1, 0),
        Position = UDim2.new(1, -52, 0, 0),
        BackgroundTransparency = 1,
        Text = tostring(value),
        TextColor3 = GREEN,
        TextSize = 12,
        Font = Enum.Font.GothamBold,
        ZIndex = 3
    }, bar)

    local draggingSlider = false

    local function SetValue(inputX)
        local percent = math.clamp(
            (inputX - bar.AbsolutePosition.X) / bar.AbsoluteSize.X,
            0,
            1
        )

        local raw = min + (max - min) * percent

        value = math.clamp(
            math.floor(raw / increment + 0.5) * increment,
            min,
            max
        )

        local fraction = (value - min) / (max - min)

        fill.Size = UDim2.new(fraction, 0, 1, 0)
        number.Text = tostring(value)
        number.TextColor3 = fraction >= 0.78 and BLACK or GREEN

        Protect(options.Callback, value)
    end

    bar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            draggingSlider = true
            SetValue(input.Position.X)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if draggingSlider and (
            input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch
        ) then
            SetValue(input.Position.X)
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            draggingSlider = false
        end
    end)

    return frame
end

