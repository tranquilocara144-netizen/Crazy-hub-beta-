-- ================== FUNÇÃO TOCAR MÚSICA ==================
local function PlayMusic(id)
    if CurrentSound then
        CurrentSound:Destroy()
        CurrentSound = nil
    end

    local sound = Instance.new("Sound")
    sound.Name = "CrazyHubMusic"
    sound.Parent = workspace
    sound.SoundId = "rbxassetid://" .. tostring(id)
    sound.Volume = MusicVolume
    sound.PlaybackSpeed = MusicSpeed
    sound.Looped = true

    CurrentSound = sound
    sound:Play()

    Notify("Música iniciada")
end

MusicTab:AddButton({
    Name = "TOCAR MÚSICA",
    Callback = function()
        local id = MusicID:gsub("%s+", "")

        if id == "" or not tonumber(id) then
            Notify("Digite um ID de música válido")
            return
        end

        PlayMusic(id)
    end
})

