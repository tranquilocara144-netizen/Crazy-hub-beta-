-- ================== TELEPORT ==================
local TPQuery = ""

TeleportTab:AddTextbox({
    Name = "Nick do jogador",
    Placeholder = "Digite o nick...",
    Callback = function(Value)
        TPQuery = Value
    end
})

TeleportTab:AddButton({
    Name = "TELEPORTAR",
    Callback = function()
        local query = TPQuery:lower():gsub("^%s*(.-)%s*$", "%1")

        if query == "" then
            Notify("Digite o nick de um jogador")
            return
        end

        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= Player and plr.Name:lower():sub(1, #query) == query then
                local target = plr.Character
                local targetRoot = target and target:FindFirstChild("HumanoidRootPart")
                local myRoot = GetRoot()

                if targetRoot and myRoot then
                    myRoot.CFrame = targetRoot.CFrame * CFrame.new(0, 0, -3)
                    Notify("Teleportado para " .. plr.Name)
                    return
                end
            end
        end

        Notify("Jogador não encontrado")
    end
})

