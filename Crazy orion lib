			fim)  

			Função Bind:Set(Key)  
				Bind.Binding = falso  
				Bind.Value = Key ou Bind.Value  
				Bind.Value = Bind.Value.Name ou Bind.Value  
				BindBox.Value.Text = Bind.Value  
			fim  

			Bind:Set(BindConfig.Default)  
			se BindConfig.Flag então				  
				OrionLib.Flags[BindConfig.Flag] = Bind  
			fim  
			retornar Bind  
