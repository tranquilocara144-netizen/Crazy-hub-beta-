						Tamanho = UDim2.new(1, 0, 0, 1),  
						Posição = UDim2.new(0, 0, 1, -1),  
						Nome = "Linha",  
						Visível = falso  
					}), "AVC"),  
				}), {  
					Tamanho = UDim2.new(1, 0, 0, 38),  
					ClipsDescendants = verdadeiro,  
					Nome = "F"  
				}),  
				Contêiner do seletor de cores,  
				AddThemeObject(MakeElement("Stroke"), "Stroke"),  
			}), "Segundo")  

			AdicionarConexão(Click.MouseButton1Click, função()  
				Colorpicker.Toggled = não Colorpicker.Toggled  
				TweenService:Create(ColorpickerFrame,TweenInfo.new(.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),{Size = Colorpicker.Toggled and UDim2.new(1, 0, 0, 148) or UDim2.new(1, 0, 0, 38)}):Play()  
				Cor.Visível = Seletor de cores.Alternado  
				Matiz.Visível = Seletor de cores.Alternado  
				ColorpickerFrame.F.Line.Visible = Colorpicker.Toggled  
			fim)  

			função local UpdateColorPicker()  
				ColorpickerBox.BackgroundColor3 = Color3.fromHSV(ColorH, ColorS, ColorV)  
				Color.BackgroundColor3 = Color3.fromHSV(ColorH, 1, 1)  
				Seletor de cores:Definir(ColorpickerBox.BackgroundColor3)  
				ColorpickerConfig.Callback(ColorpickerBox.BackgroundColor3)  
				SalvarCfg(jogo.GameId)  
			fim  

			ColorH = 1 - (math.clamp(HueSelection.AbsolutePosition.Y - Hue.AbsolutePosition.Y, 0, Hue.AbsoluteSize.Y) / Hue.AbsoluteSize.Y)  
			ColorS = (math.clamp(ColorSelection.AbsolutePosition.X - Color.AbsolutePosition.X, 0, Color.AbsoluteSize.X) / Color.AbsoluteSize.X)  
			ColorV = 1 - (math.clamp(ColorSelection.AbsolutePosition.Y - Color.AbsolutePosition.Y, 0, Color.AbsoluteSize.Y) / Color.AbsoluteSize.Y)  

			AdicionarConexão(Color.InputBegan, função(entrada)  
				Se input.UserInputType == Enum.UserInputType.MouseButton1 ou input.UserInputType == Enum.UserInputType.Touch então  
					se ColorInput então  
						ColorInput:Desconectar()  
					fim  
					ColorInput = AddConnection(RunService.RenderStepped, função()  
						local ColorX = (math.clamp(Mouse.X - Color.AbsolutePosition.X, 0, Color.AbsoluteSize.X) / Color.AbsoluteSize.X)  
						local ColorY = (math.clamp(Mouse.Y - Color.AbsolutePosition.Y, 0, Color.AbsoluteSize.Y) / Color.AbsoluteSize.Y)  
						ColorSelection.Position = UDim2.new(ColorX, 0, ColorY, 0)  
						ColorS = ColorX  
						CorV = 1 - CorY  
						AtualizarSeletorDeCores()  
					fim)  
				fim  
			fim)  

			AdicionarConexão(Color.InputEnded, função(entrada)  
				Se input.UserInputType == Enum.UserInputType.MouseButton1 ou input.UserInputType == Enum.UserInputType.Touch então  
					se ColorInput então  
						ColorInput:Desconectar()  
					fim  
				fim  
			fim)  

			AdicionarConexão(Hue.InputBegan, função(entrada)  
				Se input.UserInputType == Enum.UserInputType.MouseButton1 ou input.UserInputType == Enum.UserInputType.Touch então  
					se HueInput então  
						HueInput:Desconectar()  
					fim;  

					HueInput = AddConnection(RunService.RenderStepped, function()  
						local HueY = (math.clamp(Mouse.Y - Hue.AbsolutePosition.Y, 0, Hue.AbsoluteSize.Y) / Hue.AbsoluteSize.Y)  

						HueSelection.Position = UDim2.new(0.5, 0, HueY, 0)  
						CorH = 1 - MatizY  

						AtualizarSeletorDeCores()  
					fim)  
				fim  
			fim)  

			AdicionarConexão(Hue.EntradaEncerrada, função(entrada)  
				Se input.UserInputType == Enum.UserInputType.MouseButton1 ou input.UserInputType == Enum.UserInputType.Touch então  
					se HueInput então  
						HueInput:Desconectar()  
					fim  
				fim  
			fim)  

			função Seletor de cores:Definir(Valor)  
				Seletor de cores.Valor = Valor  
				ColorpickerBox.BackgroundColor3 = Colorpicker.Value  
				ColorpickerConfig.Callback(Colorpicker.Value)  
			fim  

			Seletor de cores:Definir(Seletor de cores.Valor)  
			se ColorpickerConfig.Flag então				  
				OrionLib.Flags[ColorpickerConfig.Flag] = Seletor de cores  
			fim  
			retornar Seletor de cores  
		fim    
		retornar ElementoFunção     
	fim	  

